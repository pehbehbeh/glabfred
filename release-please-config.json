{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-as": "1.0.0",
  "packages": {
    ".": {
      "release-type": "node",
      "include-component-in-tag": false,
      "extra-files": [
        {
          "type": "xml",
          "path": "info.plist",
          "xpath": "/plist/dict/key[text()='version']/following-sibling::string[1]"
        }
      ]
    }
  }
}
